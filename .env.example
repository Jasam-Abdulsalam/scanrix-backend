# Application
APP_NAME="Scanrix API"
DEBUG=True

# MongoDB (e.g. MongoDB Atlas connection string or local MongoDB)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="SCANRIX"

# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini AI (Required for ingredient analysis)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Groq API (Optional: fast primary LLM before Gemini fallback)
GROQ_API_KEY="your-groq-api-key-here"

# Upstash Redis (Required for scan rate limiting & AI response caching)
# Create a free database at: https://upstash.com/
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Google Sign-In (Optional: Required only if testing POST /api/v1/auth/google)
GOOGLE_CLIENT_ID=""
FIREBASE_PROJECT_ID=""
