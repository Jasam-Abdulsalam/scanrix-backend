# Application
APP_NAME="Scanrix API"
DEBUG=True
# Testing only: true skips the daily scan limit. Keep false in production.
TEST_MODE=false

# MongoDB (e.g. MongoDB Atlas connection string or local MongoDB)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="SCANRIX"

# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini AI (Required for ingredient analysis)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Groq API (Optional: fast primary LLM before Gemini fallback)
GROQ_API_KEY="your-groq-api-key-here"

# Set true only once AI keys are configured. False = unknown ingredients stay "not assessed".
AI_FALLBACK_ENABLED=false

# Upstash Redis (Required for scan rate limiting & AI response caching)
# Create a free database at: https://upstash.com/
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Google Sign-In (Optional: Required only if testing POST /api/v1/auth/google)
GOOGLE_CLIENT_ID=""
# Extra client IDs whose Google tokens are also accepted, comma-separated.
# Put the iOS OAuth client ID here (iOS tokens carry it instead of the web one).
GOOGLE_EXTRA_CLIENT_IDS=""
FIREBASE_PROJECT_ID=""

# Opt-in "Get AI verdict": weekly credits per user, cache lifetime, per-call timeout
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.6-flash
GROQ_MAX_OUTPUT_TOKENS=2048
AI_CREDITS_PER_WEEK=6
AI_ANALYSIS_TTL_DAYS=90
AI_ANALYSIS_TIMEOUT_SECONDS=30
AI_ALTERNATIVES_TTL_DAYS=30
AI_NATURAL_REMEDY_TTL_DAYS=90

# Scan endpoints: max scans per user per minute (abuse protection, not a quota)
SCAN_RATE_LIMIT_PER_MINUTE=30

# Saved products: max favorites per user
FAVORITES_MAX_PER_USER=500

# Product photos for AI alternatives: private SearXNG image search (docker-compose runs it and sets
# SEARXNG_URL for the app). Outside Docker, set SEARXNG_URL yourself or leave it empty (photos then
# come only from Open Food/Beauty Facts). SEARXNG_SECRET: any long random string.
SEARXNG_URL=""
SEARXNG_SECRET=""
